<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Shared container the app uses to hand the Safari content-blocker extension its rule JSON.
         Automatic signing provisions the App Group with no special Apple approval — unlike Family
         Controls, which is why this build (site blocking only) ships to TestFlight directly. -->
    <key>com.apple.security.application-groups</key>
    <array>
        <string>group.com.pauljohnson.siteblocker</string>
    </array>
</dict>
</plist>
