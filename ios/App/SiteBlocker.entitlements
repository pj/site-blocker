<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Screen Time control (Development entitlement works on your own device once you approve the
         authorization prompt). Enable "Family Controls" in Signing & Capabilities. -->
    <key>com.apple.developer.family-controls</key>
    <true/>
    <!-- Shared container the app uses to hand the content-blocker extension its rule JSON. Add the
         matching App Group in Signing & Capabilities (automatic signing provisions it). -->
    <key>com.apple.security.application-groups</key>
    <array>
        <string>group.com.pauljohnson.siteblocker</string>
    </array>
</dict>
</plist>
