<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Needed to use ManagedSettings / DeviceActivity from the extension. -->
    <key>com.apple.developer.family-controls</key>
    <true/>
    <!-- Same App Group as the app, to read the shared rules and drive the content blocker. -->
    <key>com.apple.security.application-groups</key>
    <array>
        <string>group.com.pauljohnson.siteblocker</string>
    </array>
</dict>
</plist>
