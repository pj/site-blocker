<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Same shared container as the app + content blocker, so the control reads/writes the unlock
         state and rewrites the ruleset. -->
    <key>com.apple.security.application-groups</key>
    <array>
        <string>group.com.pauljohnson.siteblocker</string>
    </array>
</dict>
</plist>
