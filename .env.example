# Copy to .env (gitignored) and fill in. The justfile loads this and passes it to xcodegen.
#
# Your 10-character Apple Developer Team ID.
# Find it at https://developer.apple.com/account → Membership details (or run:
#   security find-identity -v -p codesigning        # the ID in parentheses after your name
# ).
DEVELOPMENT_TEAM=XXXXXXXXXX

# Names of the Developer ID provisioning profiles you created in the Apple Developer portal
# (Certificates, Identifiers & Profiles → Profiles → Developer ID) for each App ID. These carry
# the content-filter-provider-systemextension entitlement and let the CLI Developer ID build sign
# without Xcode's Organizer. Use the exact profile *names* you gave them.
# Quote values that contain spaces (just's dotenv parser requires it).
APP_PROVISIONING_PROFILE="SiteBlocker App Developer ID"
EXT_PROVISIONING_PROFILE="SiteBlocker Extension Developer ID"

# Optional: name of the keychain profile holding notarization credentials, used by `just install`.
# Defaults to "siteblocker". Create it once with an app-specific password (appleid.apple.com):
#   xcrun notarytool store-credentials siteblocker --apple-id you@example.com --team-id XXXXXXXXXX
# NOTARY_PROFILE=siteblocker
