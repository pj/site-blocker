<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- The container app is deliberately NOT sandboxed. For Developer ID distribution (not the
         Mac App Store), the app that activates a content-filter *system extension* must be able to
         talk to sysextd; the App Sandbox blocks that XPC/mach-lookup, so OSSystemExtensionRequest
         fails immediately with "connection invalidated" / OSSystemExtensionErrorDomain error 1.
         The sandbox also blocked reading user files (the blocklist). Only the FilterExtension is
         sandboxed (required for system extensions); it reads the shared snapshot via the App Group.
         Hardened runtime + notarization still apply. -->

    <!-- Authorizes the app to install its content-filter *system extension* via
         OSSystemExtensionRequest. sysextd rejects activation without it ("Missing entitlement
         com.apple.developer.system-extension.install"). -->
    <key>com.apple.developer.system-extension.install</key>
    <true/>
    <!-- NetworkExtension capability (paid Apple Developer account). -->
    <key>com.apple.developer.networking.networkextension</key>
    <array>
        <string>content-filter-provider-systemextension</string>
    </array>
    <!-- iCloud key-value store, for syncing rules + usage across devices (the profile grants the
         wildcard YF7LH93MG3.*; this concrete id is covered by it). -->
    <key>com.apple.developer.ubiquity-kvstore-identifier</key>
    <string>$(TeamIdentifierPrefix)com.pauljohnson.siteblocker.app</string>
    <!-- Send Apple Events (hardened runtime) so the app can close browser tabs of blocked sites.
         Also gated at runtime by the user's Automation privacy approval, per target browser. -->
    <key>com.apple.security.automation.apple-events</key>
    <true/>
    <!-- Shared container the app and the extension use to exchange the PolicySnapshot. -->
    <key>com.apple.security.application-groups</key>
    <array>
        <string>group.com.pauljohnson.siteblocker</string>
    </array>
</dict>
</plist>
